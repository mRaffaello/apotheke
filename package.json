{
    "name": "apotheke-monorepo",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.8.1",
    "scripts": {
        "prepare": "husky",
        "build": "turbo run build",
        "dev": "turbo run dev",
        "docs:dev": "turbo run dev --filter @apotheke/docs",
        "typecheck": "turbo run typecheck",
        "lint": "turbo run lint",
        "lint:fix": "turbo run lint:fix",
        "test": "turbo run test",
        "fallow:audit": "bash scripts/fallow-audit.sh",
        "format": "prettier --write '{apps,packages}/**/*.{ts,tsx}'",
        "format:check": "prettier --check '{apps,packages}/**/*.{ts,tsx}'"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild",
            "sharp"
        ]
    },
    "devDependencies": {
        "@commitlint/cli": "^20.5.3",
        "@commitlint/config-conventional": "^20.5.3",
        "apotheke": "workspace:*",
        "eslint": "^9",
        "eslint-plugin-react": "^7",
        "eslint-plugin-react-hooks": "^7",
        "globals": "^17",
        "husky": "^9.1.7",
        "prettier": "^3.8.3",
        "turbo": "2.9.9",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8"
    }
}
